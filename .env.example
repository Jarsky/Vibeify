# ── Required ─────────────────────────────────────────────────────────────────
# Public URL of the site, no trailing slash. Spotify/Google redirect URIs are built from it.
PUBLIC_URL=https://vibeify.nz
# Long random string: signs sessions and encrypts stored API keys/tokens. Keep it secret and
# don't change it (stored keys become unreadable).  Generate: openssl rand -base64 48
SECRET_KEY=
# Database password used by docker-compose.yml
POSTGRES_PASSWORD=
# Database user and name (default vibeify). Set only for a database created under other names.
#POSTGRES_USER=vibeify
#POSTGRES_DB=vibeify

# ── First admin ──────────────────────────────────────────────────────────────
# Comma-separated emails and/or Spotify user ids that become admins when they sign in.
BOOTSTRAP_ADMINS=

# ── Optional first-start seeds (afterwards manage these in the admin panel) ──
# Your Spotify app's Client ID for "Continue with Spotify" (no secret needed: PKCE).
SPOTIFY_CLIENT_ID=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Host port for docker-compose.yml
VIBEIFY_PORT=8000
